# Copy this file to .env and fill in the values. Never commit .env.

# PostgreSQL connection string (create the database first)
DATABASE_URL=postgresql://user:password@localhost:5432/food_platform

# Used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# Frontend origin(s) allowed to call the API, comma-separated
CORS_ORIGINS=http://localhost:5173

# Donation text parsing (optional). Without a key the form just has to be filled in manually.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Set to true to use a fake parser (no API key needed), handy for demos and tests
LLM_MOCK=false
